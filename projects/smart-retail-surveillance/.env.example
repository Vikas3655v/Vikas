# Storage mode used by the Flask API
STORAGE_BACKEND=mysql

# CSV source used for optional CSV import and detector CSV mode
RETAIL_EVENTS=data/detections.csv

# Flask API
PORT=5000

# React frontend
VITE_API_URL=http://localhost:5000

# MySQL settings used by Docker internally
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=smart_retail
MYSQL_USER=smart_retail
MYSQL_PASSWORD=smart_retail
MYSQL_POOL_SIZE=5

# Windows live detector defaults (host connects to published MySQL port)
DETECTOR_STORAGE=mysql
DETECTOR_DEVICE=cpu
DETECTOR_MYSQL_HOST=127.0.0.1
DETECTOR_MYSQL_PORT=3307
